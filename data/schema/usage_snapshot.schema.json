{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "usage_snapshot",
  "description": "使用率データのスナップショット（取得時点・取得元を明示するためのメタテーブル）",
  "type": "object",
  "required": ["snapshot_id", "date", "source_url", "description"],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "description": "スナップショットの一意なID（例: 2026-10_single_rank）"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "データ取得日（YYYY-MM-DD）"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "取得元URL（例: https://champs.pokedb.tokyo/pokemon/list?rule=0）"
    },
    "description": {
      "type": "string",
      "description": "シーズン名・ルール（シングル等）など補足説明"
    }
  },
  "additionalProperties": false
}
