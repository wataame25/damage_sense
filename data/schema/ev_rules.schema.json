{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ev_rules",
  "description": "出題時の能力ポイント（努力値）・性格の選択ルール。値そのものは pokemon.json の stat_point_usage / nature_usage に種族ごとに格納",
  "type": "object",
  "required": [
    "system",
    "stat_formula",
    "usage_threshold",
    "selection"
  ],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "string",
      "enum": [
        "champions_stat_points"
      ]
    },
    "stat_formula": {
      "type": "object",
      "required": [
        "level",
        "hp",
        "other"
      ],
      "properties": {
        "level": {
          "type": "integer"
        },
        "hp": {
          "type": "string"
        },
        "other": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "usage_threshold": {
      "type": "number",
      "description": "これ未満の採用率（%）の性格・振り方・持ち物は選ばない"
    },
    "selection": {
      "type": "object",
      "required": [
        "stat_points",
        "nature",
        "applies_to"
      ],
      "properties": {
        "stat_points": {
          "type": "string"
        },
        "nature": {
          "type": "string"
        },
        "applies_to": {
          "type": "string"
        }
      }
    }
  }
}
