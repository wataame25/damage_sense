{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pokemon",
  "description": "ポケモン一覧。種族名単位のテーブル（タイプ、特性3つまで、技5つまで、種族値、使用率データ、メガ進化の固定ルールを含む）",
  "type": "object",
  "required": [
    "id",
    "name",
    "types",
    "abilities",
    "base_stats",
    "moves",
    "snapshot_id",
    "usage_rank",
    "usage_rate",
    "is_defensive_only",
    "is_mega",
    "form_selection",
    "ability_usage",
    "nature_usage",
    "stat_point_usage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ポケモンの一意なID（ローマ字スラグ、例: garchomp / garchomp_mega）"
    },
    "name": {
      "type": "string",
      "description": "ポケモン名（日本語、メガ進化は『メガガブリアス』のように表記）"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string"
      },
      "description": "タイプ（最大2つ）"
    },
    "abilities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "description": "abilities.id への参照"
      },
      "description": "通常特性（最大2）＋隠れ特性（1）。最大3件。採用率の高い順"
    },
    "base_stats": {
      "type": "object",
      "required": [
        "hp",
        "attack",
        "defense",
        "sp_attack",
        "sp_defense",
        "speed"
      ],
      "description": "種族値（努力値・個体値は含まない。努力値はmain実行ファイル側で割り振る）",
      "properties": {
        "hp": {
          "type": "integer"
        },
        "attack": {
          "type": "integer"
        },
        "defense": {
          "type": "integer"
        },
        "sp_attack": {
          "type": "integer"
        },
        "sp_defense": {
          "type": "integer"
        },
        "speed": {
          "type": "integer"
        }
      }
    },
    "moves": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "description": "moves.id への参照"
      },
      "description": "採用率上位の攻撃技5つ（変化技は除く）＋採用率上位5位以内に入っている積み技（りゅうのまい/つるぎのまい/わるだくみ/ちょうのまい）。採用率順"
    },
    "snapshot_id": {
      "type": "string",
      "description": "usage_snapshot.snapshot_id への参照"
    },
    "usage_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "使用率ランキング順位（上位50位以内のみ採用）"
    },
    "usage_rate": {
      "type": [
        "number",
        "null"
      ],
      "description": "使用率（%）。データソース（champs.pokedb.tokyo）がポケモン単体の使用率%を公開していないため、現状はnull（使用率ランキングの順位usage_rankのみ取得可能）"
    },
    "item_candidates": {
      "type": "array",
      "maxItems": 5,
      "description": "火力アップ持ち物のうち所持率10%以上の候補（最大5件）",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "usage_rate"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "description": "items.id への参照"
          },
          "usage_rate": {
            "type": "number",
            "description": "使用率（%）"
          }
        }
      }
    },
    "mega_stone_usage_rate": {
      "type": [
        "number",
        "null"
      ],
      "description": "メガストーン所持率（%）。60%超で常時メガ、30%超60%以下でランダムにメガ/通常を出題。該当なしはnull"
    },
    "is_defensive_only": {
      "type": "boolean",
      "description": "守備的ポケモンのため攻撃側には選出しないフラグ（例: アーマーガア、ドヒドイデ、ピクシー）"
    },
    "boost_move_used_flag_eligible": {
      "type": "boolean",
      "default": false,
      "description": "りゅうのまい/つるぎのまい/わるだくみ/ちょうのまい等を持つ場合、ランダムで1回使用済み状態として出題してよいか"
    },
    "is_mega": {
      "type": "boolean",
      "description": "メガ進化後の個体かどうか"
    },
    "mega_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "is_mega=trueの場合、進化元ポケモンのidを指す。通常個体はnull"
    },
    "fixed_mega_only": {
      "type": "boolean",
      "default": false,
      "description": "懸念事項対応：この種族は特定のメガフォルムのみ出題する/メガを出題しない、という固定ルールがある場合true。詳細はmega_fixed_noteに記載"
    },
    "mega_fixed_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "固定ルールの内容（例: 'メガリザードンYのみ出題（特殊型）', 'メガガブリアスは出題しない（通常のガブリアスのみ）'）"
    },
    "ability_usage": {
      "type": "array",
      "maxItems": 3,
      "description": "特性の採用率（%）。出題時はこの採用率で重み付けして特性を抽選する。メガ形態は単一特性のため100",
      "items": {
        "type": "object",
        "required": [
          "ability_id",
          "usage_rate"
        ],
        "properties": {
          "ability_id": {
            "type": "string",
            "description": "abilities.id への参照"
          },
          "usage_rate": {
            "type": "number",
            "description": "採用率（%）"
          }
        },
        "additionalProperties": false
      }
    },
    "form_selection": {
      "type": "string",
      "enum": [
        "fixed",
        "random",
        "excluded"
      ],
      "description": "出題時の形態選択。fixed=この形態で固定出題、random=同一種族のrandom行の中からランダムに1つ選ぶ、excluded=出題しない。メガ／メガZ／メガX・Yはいずれも通常形態からの分岐として扱い、同一種族内で1形態のみが選ばれる"
    },
    "nature_usage": {
      "type": "array",
      "description": "性格（能力補正）の採用率。採用率10%以上のみ格納。メガ形態は通常形態と同じ値（データソースが種族単位のため）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "up",
          "down",
          "usage_rate"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "性格名（例: ようき）"
          },
          "up": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hp",
              "attack",
              "defense",
              "sp_attack",
              "sp_defense",
              "speed",
              null
            ],
            "description": "1.1倍になるステータス。無補正の性格はnull"
          },
          "down": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hp",
              "attack",
              "defense",
              "sp_attack",
              "sp_defense",
              "speed",
              null
            ],
            "description": "0.9倍になるステータス。無補正の性格はnull"
          },
          "usage_rate": {
            "type": "number"
          }
        }
      }
    },
    "stat_point_usage": {
      "type": "array",
      "description": "能力ポイント振りの採用率。champs.pokedb.tokyoの『合算』グループ単位で採用率10%以上のみ格納し、各グループ内に実際の振り方（個別）とその採用率を持つ",
      "items": {
        "type": "object",
        "required": [
          "label",
          "usage_rate",
          "spreads"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "description": "グループ名（例: AS = こうげき・すばやさ32振り＋余り）"
          },
          "usage_rate": {
            "type": "number",
            "description": "グループ全体の採用率（%）"
          },
          "spreads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "usage_rate",
                "points"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "usage_rate": {
                  "type": "number"
                },
                "points": {
                  "type": "object",
                  "required": [
                    "hp",
                    "attack",
                    "defense",
                    "sp_attack",
                    "sp_defense",
                    "speed"
                  ],
                  "properties": {
                    "hp": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "attack": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "defense": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "sp_attack": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "sp_defense": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "speed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
